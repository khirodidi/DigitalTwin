# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY frontend/package.json .
RUN npm install --no-audit --no-fund

COPY frontend/ .

# Only connection settings are baked in at build time. Factory layout (name,
# grid size, blueprint) is configured at runtime and stored in PostgreSQL.
ARG REACT_APP_API_URL=http://localhost:8000
ARG REACT_APP_WS_URL=ws://localhost:8000/ws
ENV REACT_APP_API_URL=$REACT_APP_API_URL \
    REACT_APP_WS_URL=$REACT_APP_WS_URL

# CI=true (Docker's default) makes CRA treat ESLint WARNINGS as errors.
ENV CI=false
# Skip linting entirely during the production build. Lint is a development
# concern; an unused variable must not stop a deployment.
ENV DISABLE_ESLINT_PLUGIN=true
ENV GENERATE_SOURCEMAP=false
# Give webpack enough heap on larger source trees
ENV NODE_OPTIONS=--max-old-space-size=4096

# NOTE: no pipe here. In /bin/sh a pipeline returns the exit status of the
# LAST command, so `npm run build | tee` would report success even when the
# build failed — masking the error and letting an empty image ship.
RUN rm -rf build && npm run build

# Verify the bundle exists; print the directory if not so the cause is obvious
RUN if [ ! -f build/index.html ]; then \
      echo "=== BUILD PRODUCED NO index.html ==="; ls -la build 2>/dev/null || echo "(no build dir)"; \
      exit 1; \
    fi && \
    if ! ls build/static/js/*.js >/dev/null 2>&1; then \
      echo "=== NO JS BUNDLE PRODUCED ==="; find build -type f | head -40; \
      exit 1; \
    fi && \
    echo "Build OK:" && ls -la build/static/js/

# ── Serve stage ───────────────────────────────────────────────────────────────
FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
