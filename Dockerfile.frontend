# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY frontend/package.json .
RUN npm install

COPY frontend/ .

# Build-time configuration (override in docker-compose.yml → build.args)
ARG REACT_APP_FACTORY_IMAGE=""
ARG REACT_APP_GRID_COLS=6
ARG REACT_APP_GRID_ROWS=5
ARG REACT_APP_SENSOR_COUNT=30
ARG REACT_APP_FACTORY_NAME=Factory
ARG REACT_APP_API_URL=http://localhost:8000
ARG REACT_APP_WS_URL=ws://localhost:8000/ws

ENV REACT_APP_FACTORY_IMAGE=$REACT_APP_FACTORY_IMAGE \
    REACT_APP_GRID_COLS=$REACT_APP_GRID_COLS \
    REACT_APP_GRID_ROWS=$REACT_APP_GRID_ROWS \
    REACT_APP_SENSOR_COUNT=$REACT_APP_SENSOR_COUNT \
    REACT_APP_FACTORY_NAME=$REACT_APP_FACTORY_NAME \
    REACT_APP_API_URL=$REACT_APP_API_URL \
    REACT_APP_WS_URL=$REACT_APP_WS_URL

RUN npm run build

# ── Serve stage ───────────────────────────────────────────────────────────────
FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
