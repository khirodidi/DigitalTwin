# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY frontend/package.json .
RUN npm install
COPY frontend/ .

# Only connection settings are baked in at build time.
# Factory layout (name, grid size, blueprint) is configured at runtime through
# the Configuration page and persisted in PostgreSQL.
ARG REACT_APP_API_URL=http://localhost:8000
ARG REACT_APP_WS_URL=ws://localhost:8000/ws
ENV REACT_APP_API_URL=$REACT_APP_API_URL \
    REACT_APP_WS_URL=$REACT_APP_WS_URL

# CI=true turns ESLint warnings into errors, which fails the build for things
# like an unused variable. Keep warnings visible but non-fatal.
ENV CI=false
ENV GENERATE_SOURCEMAP=false

# Remove any build directory that slipped in, then compile fresh.
# The build log is printed in full so compile errors are visible in Docker.
RUN rm -rf build && npm run build 2>&1 | tee /tmp/build.log || \
    (echo "=== BUILD FAILED — last 60 lines ===" && tail -60 /tmp/build.log && exit 1)

# Fail the image build loudly if the bundle is missing, instead of shipping
# an empty web root that serves a blank page.
RUN test -f build/index.html && ls build/static/js/*.js >/dev/null

# ── Serve stage ───────────────────────────────────────────────────────────────
FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
