# ── Factory layout ────────────────────────────────────────────────────────────
REACT_APP_FACTORY_IMAGE=factory_blueprint.png   # place image in frontend/public/
REACT_APP_GRID_COLS=6                           # sensors per row
REACT_APP_GRID_ROWS=5                           # sensors per column
REACT_APP_SENSOR_COUNT=30                       # total sensors (COLS × ROWS)
REACT_APP_FACTORY_NAME=Factory A

# ── Backend ───────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws
